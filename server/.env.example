SERVER_PORT=3000
CLIENT_ORIGIN=*

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=cryptochat

# Railway style MySQL connection string (optional, takes priority over DB_HOST/DB_USER/...):
# MYSQL_URL=mysql://user:password@host:port/database
MYSQL_URL=

# 64 hex chars (32 bytes) required for AES-256-CBC.
# Example generation command (PowerShell):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AES_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional: required only for GIF search button.
GIPHY_API_KEY=

# Optional: WebRTC ICE config for cross-network calling.
# STUN_URLS can be comma/space/semicolon separated.
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
STUN_URLS=

# TURN is strongly recommended for calls across strict NAT/firewalls.
# Use TURN_URLS to provide multiple transports/ports:
# TURN_URLS=turn:turn.your-domain.com:3478?transport=udp,turn:turn.your-domain.com:443?transport=tcp,turns:turn.your-domain.com:443?transport=tcp
TURN_URLS=

# Backward-compatible single TURN URL (optional if TURN_URLS is used):
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# WebRTC transport policy:
# all   = try direct P2P first, then relay
# relay = force TURN relay (best for locked-down networks)
ICE_TRANSPORT_POLICY=all

# ICE candidate pool size (0-16). Higher can improve setup speed.
ICE_CANDIDATE_POOL_SIZE=4
