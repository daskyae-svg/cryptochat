SERVER_PORT=3000
CLIENT_ORIGIN=*

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=cryptochat

# Railway style MySQL connection string (optional, takes priority over DB_HOST/DB_USER/...):
# MYSQL_URL=mysql://user:password@host:port/database
MYSQL_URL=

# 64 hex chars (32 bytes) required for AES-256-CBC.
# Example generation command (PowerShell):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AES_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional: required only for GIF search button.
GIPHY_API_KEY=

# Optional: recommended for voice calls across different networks/NATs.
# TURN_URL examples:
# TURN_URL=turn:turn.your-provider.com:3478
# TURN_URL=turns:turn.your-provider.com:5349
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
